{
  "name": "ssa-admin",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
