# Servidor
PORT=4500
NODE_ENV=development

# Orígenes permitidos para el panel admin (coma-separado). La tienda NO va aquí:
# entra por sus funciones serverless, no desde el navegador.
# EN PRODUCCIÓN debe incluir el dominio donde vive el panel en Vercel; el API
# ve ese Origin a través del rewrite, y si falta, toda escritura da 403.
CLIENT_ORIGIN=http://localhost:5174

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/ssa_admin

# Sesión admin (JWT en cookie httpOnly)
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Credenciales del panel. Son la FUENTE DE VERDAD: el seed las reconcilia en cada
# arranque, así que para rotar la clave se cambia aquí y se reinicia. No hay
# pantalla en el panel para cambiarla. El usuario no tiene que ser un correo.
# SEED_ADMIN_PASSWORD es OBLIGATORIA en producción: sin ella el servidor no arranca.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambia-esta-clave

# Secreto compartido con las funciones serverless de la tienda (mismo valor en
# la variable STORE_PROXY_SECRET del proyecto de Vercel de ssa_store).
# Sin él, el rate limit de los endpoints públicos usa la IP de salida de Vercel
# y todos los compradores comparten el mismo cupo.
# Genéralo con: openssl rand -base64 32
STORE_PROXY_SECRET=

# Cloudinary (imágenes de productos, comprobantes, encargos y contenido).
# Si faltan, la subida de imágenes responde 503 pero el resto del API funciona.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push para avisos de pedidos nuevos en el admin (opcional).
# Genera llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ssaimport.co

# Correos transaccionales al comprador (Resend). Sin la key no se manda nada y
# el resto del API funciona igual.
# EMAIL_FROM tiene que ser de un dominio VERIFICADO en resend.com/domains o la
# API responde 403 y ningún correo sale.
RESEND_API_KEY=
EMAIL_FROM=SSA Import <no-reply@ssaimport.com>
EMAIL_REPLY_TO=
STORE_URL=https://ssaimport.com
