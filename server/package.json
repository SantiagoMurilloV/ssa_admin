{
  "name": "ssa-admin-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env -e \"import('./src/db/migrate.js').then(m => m.migrate()).then(() => process.exit(0))\"",
    "seed": "node --env-file-if-exists=.env -e \"import('./src/db/seed.js').then(m => m.seed()).then(() => process.exit(0))\"",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "zod": "^4.0.14"
  }
}
